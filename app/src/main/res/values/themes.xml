<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Dpolls" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Dpolls.Splash" parent="Theme.SplashScreen">
        <!-- Set your brand color -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- Set your logo (should be a 96x96dp PNG or vector) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_splash_v3</item>
        <!-- Optional: duration for icon animation -->
        <item name="postSplashScreenTheme">@style/Theme.Dpolls</item>
    </style>
</resources>